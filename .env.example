# Telegram credentials: fill privately on the server, never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=/data/telegram/user.session
BOT_TOKEN=
OWNER_TELEGRAM_ID=

# ChatGPT-managed Codex login ONLY. No API key or separate API billing.
# Current/legacy model is the last fallback, not the main analyst.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
RESEARCH_MODEL=gpt-5.6-luna
ANALYST_MODEL=gpt-6-astra
ANALYST_FALLBACK_MODEL=gpt-5.6-sol
CODEX_EXECUTABLE=codex
# Minimum accepted version; Docker image pins 0.157.1.
CODEX_REQUIRED_VERSION=0.153.0
CODEX_HOME=/data/codex
CODEX_TEMP_ROOT=/tmp/market-digest
CODEX_TIMEOUT_SECONDS=900
CODEX_MAX_OUTPUT_BYTES=16000000
OPENAI_BATCH_CHAR_BUDGET=220000
OPENAI_REDUCE_MAX_LEVELS=8
ANALYST_CHAR_BUDGET=180000

APP_TIMEZONE=Europe/Samara
DIGEST_HOUR=15
DIGEST_MINUTE=0
SENTIMENT_HOUR=16
SENTIMENT_MINUTE=0
POSTS_FOLDER_NAME=Посты
CHATS_FOLDER_NAME=Чаты
RUNTIME_STATE_PATH=/data/state/runtime.json
RESEARCH_HISTORY_PATH=/data/state/research.json
LOG_LEVEL=INFO
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
COLLECTOR_RECONNECT_DELAY_SECONDS=5
TELEGRAM_SEND_DELAY_SECONDS=0.05
